APP_ADDR=:8081
APP_ENV=development
APP_NAME=MyCasaPro
APP_PUBLIC_URL=http://localhost:8081
APP_WEB_URL=http://localhost:3000
APP_ALLOWED_ORIGINS=http://localhost:3000
APP_STORE_BACKEND=postgres
APP_DATABASE_URL=postgres://mycasapro:mycasapro_local@localhost:5432/mycasapro?sslmode=disable
APP_AUTO_MIGRATE=true
APP_MIGRATIONS_DIR=app/migrations
APP_UPLOAD_DIR=var/uploads
