# Public hostname. Point its A/AAAA record at this server before deployment.
MYCASAPRO_DOMAIN=repairs.example.com
MYCASAPRO_TLS_EMAIL=ops@example.com

# Pin the matching application release. Avoid latest after launch.
MYCASAPRO_VERSION=v0.2.0

# Use a URL-safe random value: openssl rand -hex 32
MYCASAPRO_DB_PASSWORD=replace-with-a-random-64-character-hex-value

# SMTP delivery. STARTTLS on port 587 is the recommended default.
MYCASAPRO_MAIL_FROM_EMAIL=repairs@example.com
MYCASAPRO_MAIL_FROM_NAME=MyCasaPro
MYCASAPRO_SMTP_HOST=smtp.example.com
MYCASAPRO_SMTP_PORT=587
MYCASAPRO_SMTP_USERNAME=smtp-user
MYCASAPRO_SMTP_PASSWORD=replace-with-smtp-password
MYCASAPRO_SMTP_TLS_MODE=starttls
